@model List<MSSC.Web.Models.CaseStudy>
@{
}

<section class="page-hero cases-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            <h1>@Lang.T("Case Studies", "دراسات الحالة")</h1>
            <p class="lead">@Lang.T("Explore our success stories and discover how we've helped organizations achieve transformational results", "استكشف قصص نجاحنا واكتشف كيف ساعدنا المؤسسات على تحقيق نتائج تحويلية")</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("Case Studies", "دراسات الحالة")</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="case-studies-grid">
            @foreach (var caseStudy in Model)
            {
                <div class="case-study-card" data-aos="fade-up">
                    <div class="case-study-image">
                        <img src="@caseStudy.ImageUrl" alt="@caseStudy.TitleLocalized" onerror="this.src='/images/case-study-default.jpg'">
                        <span class="case-study-industry">@caseStudy.IndustryLocalized</span>
                    </div>
                    <div class="case-study-content">
                        <span class="client-badge">@caseStudy.ClientNameLocalized</span>
                        <h3>@caseStudy.TitleLocalized</h3>
                        <div class="case-summary">
                            <div class="summary-item">
                                <strong>@Lang.T("Challenge:", "التحدّي:")</strong>
                                <p>@caseStudy.ChallengeLocalized.Substring(0, Math.Min(caseStudy.ChallengeLocalized.Length, 100))...</p>
                            </div>
                            <div class="summary-item">
                                <strong>@Lang.T("Results:", "النتائج:")</strong>
                                <p>@string.Join("، ", caseStudy.ResultsLocalized.Take(2))</p>
                            </div>
                        </div>
                        <div class="case-metrics">
                            @foreach (var metric in caseStudy.MetricsLocalized.Take(3))
                            {
                                <span class="metric-badge">@metric</span>
                            }
                        </div>
                        <div class="case-services">
                            <strong>@Lang.T("Services:", "الخدمات:")</strong>
                            @foreach (var service in caseStudy.ServicesUsedLocalized)
                            {
                                <span class="service-tag">@service</span>
                            }
                        </div>
                        <a href="/case-studies/@caseStudy.Slug" class="btn btn-primary mt-3">@Lang.T("Read Full Case Study", "اقرأ دراسة الحالة كاملة")</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Styles {
<style>
    .case-studies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
        gap: 40px;
    }

    .case-study-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

    .case-study-card:hover {
        transform: translateY(-10px);
    }

    .case-study-image {
        position: relative;
        height: 250px;
        overflow: hidden;
    }

    .case-study-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .case-study-card:hover .case-study-image img {
        transform: scale(1.05);
    }

    .case-study-industry {
        position: absolute;
        top: 15px;
        left: 15px;
        background: var(--primary);
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .case-study-content {
        padding: 30px;
    }

    .client-badge {
        display: inline-block;
        padding: 4px 12px;
        background: var(--bg-light);
        color: var(--primary);
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 15px;
    }

    .case-study-content h3 {
        font-size: 1.4rem;
        margin-bottom: 20px;
        color: var(--text-dark);
    }

    .case-summary {
        margin-bottom: 20px;
    }

    .summary-item {
        margin-bottom: 15px;
    }

    .summary-item strong {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 5px;
    }

    .summary-item p {
        margin: 0;
        font-size: 0.95rem;
        color: var(--text-dark);
    }

    .case-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 15px;
    }

    .metric-badge {
        display: inline-block;
        padding: 6px 14px;
        background: #e8f5e9;
        color: #2e7d32;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .case-services {
        margin-bottom: 10px;
    }

    .case-services strong {
        font-size: 0.85rem;
        color: var(--text-muted);
        display: block;
        margin-bottom: 8px;
    }

    .service-tag {
        display: inline-block;
        padding: 4px 10px;
        background: var(--bg-light);
        border-radius: 15px;
        font-size: 0.8rem;
        margin-right: 5px;
        margin-bottom: 5px;
    }

    .cta-section {
        background: var(--primary);
        color: white;
    }

    .cta-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    @@media (max-width: 768px) {
        .case-studies-grid {
            grid-template-columns: 1fr;
        }

        .cta-buttons {
            flex-direction: column;
            align-items: center;
        }
    }
</style>
}
