@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var linkedInPartnerId = (Configuration["Analytics:LinkedIn:PartnerId"] ?? string.Empty).Trim();
    var linkedInHosts = Configuration["Analytics:LinkedIn:Hosts"] ?? string.Empty;
    var linkedInReqHost = Context.Request.Host.Host ?? string.Empty;

    var linkedInIdValid = linkedInPartnerId.Length > 0 && linkedInPartnerId.All(char.IsAsciiDigit);

    var linkedInAllowedHosts = linkedInHosts
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var linkedInOnAllowedHost = linkedInAllowedHosts.Length == 0
        || linkedInAllowedHosts.Any(h =>
            linkedInReqHost.Equals(h, StringComparison.OrdinalIgnoreCase)
            || linkedInReqHost.EndsWith("." + h, StringComparison.OrdinalIgnoreCase));
}
@if (linkedInIdValid && linkedInOnAllowedHost)
{
    <script>
        _linkedin_partner_id = "@linkedInPartnerId";
        window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
        window._linkedin_data_partner_ids.push(_linkedin_partner_id);
    </script>
    <script>
    (function(l) {
    if (!l){window.lintrk = function(a,b){window.lintrk.q.push([a,b])};
    window.lintrk.q=[]}
    var s = document.getElementsByTagName("script")[0];
    var b = document.createElement("script");
    b.type = "text/javascript";b.async = true;
    b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
    s.parentNode.insertBefore(b, s);})(window.lintrk);
    </script>
}
