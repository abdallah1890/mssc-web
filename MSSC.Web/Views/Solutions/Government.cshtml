@{
}

<section class="page-hero government-solutions-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h1>تعتمد رؤية 2030 على مؤسسات أقوى <span class="text-secondary">وكوادر أكثر كفاءة.</span></h1>
            }
            else
            {
                <h1>Vision 2030 depends on stronger institutions <span class="text-secondary">and more capable people.</span></h1>
            }
            <p class="lead">@Lang.T("We help government and semi-government entities build the governance structures, performance systems, and institutional capability needed to meet rising expectations for accountability, efficiency, and sustainable execution.", "نساعد الجهات الحكومية وشبه الحكومية على بناء هياكل الحوكمة، وأنظمة الأداء، والقدرة المؤسسية اللازمة لتلبية التوقعات المتزايدة للمساءلة والكفاءة والتنفيذ المستدام.")</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("Government Solutions", "الحلول الحكومية")</li>
                </ol>
            </nav>
            <div class="mt-4">
                <a href="/contact" class="btn btn-primary btn-lg">@Lang.T("Request Institutional Readiness Diagnostic", "اطلب تشخيص الجاهزية المؤسسية")</a>
                <a href="/contact" class="btn btn-white btn-lg ms-2">@Lang.T("Book a Discovery Call", "احجز جلسة استكشافية")</a>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <span class="section-label">@Lang.T("The Challenge", "التحدّي")</span>
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">الاستراتيجية واضحة عادةً. <span class="text-primary">أما البنية التشغيلية فغالباً ليست كذلك.</span></h2>
            }
            else
            {
                <h2 class="section-title">The strategy is usually clear. <span class="text-primary">The operating infrastructure often is not.</span></h2>
            }
            <p class="section-subtitle">@Lang.T("Most public sector organizations have invested significantly in strategy development, policy frameworks, and transformation initiatives. The gap is rarely in intent — it lies in operationalization. The translation of strategic direction into consistent daily institutional practice.", "استثمرت معظم مؤسسات القطاع العام بقدر كبير في تطوير الاستراتيجيات، وأطر السياسات، ومبادرات التحوّل. ونادراً ما تكون الفجوة في النية — بل في التفعيل التشغيلي: ترجمة التوجّه الاستراتيجي إلى ممارسة مؤسسية يومية متّسقة.")</p>
        </div>

        <div class="challenge-list" data-aos="fade-up">
            <div class="challenge-item"><i class="fas fa-triangle-exclamation"></i> @Lang.T("Governance structures exist on paper but are not operationally active", "هياكل الحوكمة موجودة على الورق لكنها غير مُفعّلة تشغيلياً")</div>
            <div class="challenge-item"><i class="fas fa-triangle-exclamation"></i> @Lang.T("KPI frameworks are defined but disconnected from actual decision-making", "أطر مؤشرات الأداء مُحدَّدة لكنها منفصلة عن اتخاذ القرار الفعلي")</div>
            <div class="challenge-item"><i class="fas fa-triangle-exclamation"></i> @Lang.T("Capability programs are delivered without embedded adoption or knowledge transfer", "برامج القدرات تُقدَّم دون تبنٍّ مُضمَّن أو نقل للمعرفة")</div>
            <div class="challenge-item"><i class="fas fa-triangle-exclamation"></i> @Lang.T("ISO and EFQM preparation lack real operational depth", "إعداد ISO وEFQM يفتقر إلى عمق تشغيلي حقيقي")</div>
            <div class="challenge-item"><i class="fas fa-triangle-exclamation"></i> @Lang.T("Performance reports do not translate into accountability", "تقارير الأداء لا تُترجَم إلى مساءلة")</div>
            <div class="challenge-item"><i class="fas fa-triangle-exclamation"></i> @Lang.T("Execution depends on individuals rather than institutional mechanisms", "التنفيذ يعتمد على الأفراد بدلاً من الآليات المؤسسية")</div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">ستة عروض. <span class="text-primary">منطق واحد مترابط.</span> مُصمَّمة لبيئة عملك.</h2>
            }
            else
            {
                <h2 class="section-title">Six offers. <span class="text-primary">One connected logic.</span> Designed for your operating environment.</h2>
            }
        </div>

        <div class="solutions-table">
            <div class="solution-row" data-aos="fade-up">
                <div class="solution-row-title">@Lang.T("Institutional Readiness Diagnostic", "تشخيص الجاهزية المؤسسية")</div>
                <div class="solution-row-body">@Lang.T("A structured assessment of current governance, performance, and capability maturity with a prioritized roadmap. The appropriate starting point for any engagement.", "تقييم منظّم لمستوى نضج الحوكمة والأداء والقدرات الحالي مع خارطة طريق مُرتَّبة حسب الأولوية. نقطة البداية المناسبة لأي مشروع.")</div>
            </div>
            <div class="solution-row" data-aos="fade-up">
                <div class="solution-row-title">@Lang.T("Governance Operating System", "نظام تشغيل الحوكمة")</div>
                <div class="solution-row-body">@Lang.T("Committee frameworks, decision rights, process architecture, and authority matrices designed for the Saudi regulatory environment and the governance structures that operate within it.", "أطر اللجان، وصلاحيات اتخاذ القرار، وبنية العمليات، ومصفوفات الصلاحيات، مُصمَّمة للبيئة التنظيمية السعودية وهياكل الحوكمة العاملة فيها.")</div>
            </div>
            <div class="solution-row" data-aos="fade-up">
                <div class="solution-row-title">@Lang.T("KPI & Performance Operating System", "نظام تشغيل مؤشرات الأداء وإدارة الأداء")</div>
                <div class="solution-row-body">@Lang.T("A performance management system that enables active management at all levels — strategic KPIs cascaded to operational teams, with review rhythms and reporting structures that support decisions, not just documentation.", "نظام لإدارة الأداء يتيح إدارة فاعلة على جميع المستويات — مؤشرات استراتيجية تتدرّج حتى الفرق التشغيلية، مع إيقاعات مراجعة وهياكل تقارير تدعم القرارات لا مجرد التوثيق.")</div>
            </div>
            <div class="solution-row" data-aos="fade-up">
                <div class="solution-row-title">@Lang.T("Capability & Change Enablement", "تمكين القدرات والتغيير")</div>
                <div class="solution-row-body">@Lang.T("Role-based learning paths, adoption toolkits, and structured enablement designed so that internal teams can operate and sustain the system independently after delivery.", "مسارات تعلّم قائمة على الأدوار، وأدوات تبنٍّ، وتمكين منظّم مُصمَّم بحيث تستطيع الفرق الداخلية تشغيل النظام والحفاظ على استمراريته باستقلالية بعد التسليم.")</div>
            </div>
            <div class="solution-row" data-aos="fade-up">
                <div class="solution-row-title">@Lang.T("ISO / EFQM Readiness Enablement", "تمكين الجاهزية لـ ISO / EFQM")</div>
                <div class="solution-row-body">@Lang.T("Operational readiness for recognized standards, built with the depth required for ongoing compliance, not just audit preparation. Internal ownership is a core component of the engagement.", "جاهزية تشغيلية للمعايير المعتمدة، مبنية بالعمق اللازم للامتثال المستمر، لا لمجرد التحضير للتدقيق. والملكية الداخلية مكوّن أساسي من المشروع.")</div>
            </div>
            <div class="solution-row solution-row-training" data-aos="fade-up">
                <div class="solution-row-title">@Lang.T("Professional Training Programs", "البرامج التدريبية الاحترافية")</div>
                <div class="solution-row-body">@Lang.T("Focused, practical training in governance, KPI management, institutional performance, and capability development — aligned to Vision 2030 expectations and built around the same frameworks your institution is implementing. TVTC-accredited. Available as open enrollment or customized corporate delivery.", "تدريب مركّز وعملي في الحوكمة، وإدارة مؤشرات الأداء، والأداء المؤسسي، وتطوير القدرات — متوائم مع تطلّعات رؤية 2030 ومبنيّ على الأطر نفسها التي تطبّقها مؤسستك. معتمد من المؤسسة العامة للتدريب التقني والمهني (TVTC). متاح بتسجيل مفتوح أو تقديم مؤسسي مُخصّص.")</div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">خمسة أسباب تجعل المؤسسات العامة السعودية <span class="text-primary">تختار MSSC.</span></h2>
            }
            else
            {
                <h2 class="section-title">Five reasons Saudi public institutions <span class="text-primary">choose MSSC.</span></h2>
            }
        </div>

        <div class="sector-reasons">
            <div class="sector-reason-item" data-aos="fade-up">
                <div class="sector-reason-num">01</div>
                <div class="sector-reason-body">
                    <h4>@Lang.T("Deep understanding of the Saudi institutional environment.", "فهم عميق للبيئة المؤسسية السعودية.")</h4>
                    <p>@Lang.T("We design for how Saudi public institutions actually make decisions, operate within regulation, and develop capability — not by adapting international frameworks.", "نُصمّم وفق الطريقة التي تتّخذ بها المؤسسات العامة السعودية قراراتها فعلياً، وتعمل ضمن الأنظمة، وتطوّر قدراتها — لا عبر تكييف أُطر عالمية.")</p>
                </div>
            </div>
            <div class="sector-reason-item" data-aos="fade-up" data-aos-delay="80">
                <div class="sector-reason-num">02</div>
                <div class="sector-reason-body">
                    <h4>@Lang.T("Structured and practical approach.", "منهج منظّم وعملي.")</h4>
                    <p>@Lang.T("Full consulting rigor translated into practical outputs that internal teams can use — not reports that require a consultant to interpret.", "صرامة استشارية كاملة تُترجَم إلى مخرجات عملية تستطيع الفرق الداخلية استخدامها — لا تقارير تحتاج مستشاراً لتفسيرها.")</p>
                </div>
            </div>
            <div class="sector-reason-item" data-aos="fade-up" data-aos-delay="160">
                <div class="sector-reason-num">03</div>
                <div class="sector-reason-body">
                    <h4>@Lang.T("Sustained impact, not one-time delivery.", "أثر مستدام، لا تسليم لمرة واحدة.")</h4>
                    <p>@Lang.T("Every engagement is designed so the system operates after we leave. Enablement is built in. Internal ownership is a core deliverable.", "كل مشروع مُصمَّم بحيث يعمل النظام بعد رحيلنا. التمكين مُضمَّن، والملكية الداخلية من المخرجات الأساسية.")</p>
                </div>
            </div>
            <div class="sector-reason-item" data-aos="fade-up" data-aos-delay="240">
                <div class="sector-reason-num">04</div>
                <div class="sector-reason-body">
                    <h4>@Lang.T("Built for regulated, multi-stakeholder environments.", "مبنيّ للبيئات المنظَّمة متعدّدة الأطراف.")</h4>
                    <p>@Lang.T("We understand committee-led decision-making, procurement governance, and the oversight structures that characterize Saudi public institutions.", "نفهم اتخاذ القرار عبر اللجان، وحوكمة المشتريات، وهياكل الرقابة التي تميّز المؤسسات العامة السعودية.")</p>
                </div>
            </div>
            <div class="sector-reason-item" data-aos="fade-up" data-aos-delay="320">
                <div class="sector-reason-num">05</div>
                <div class="sector-reason-body">
                    <h4>@Lang.T("Aligned to Vision 2030 expectations.", "متوائم مع تطلّعات رؤية 2030.")</h4>
                    <p>@Lang.T("Our frameworks support the accountability, transparency, and performance discipline that Vision 2030 demands — not just in reporting, but in daily operating practice.", "تدعم أطُرنا المساءلة والشفافية وانضباط الأداء التي تتطلّبها رؤية 2030 — لا في التقارير فحسب، بل في الممارسة التشغيلية اليومية.")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="training-connection-card" data-aos="fade-up">
            <div class="training-connection-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="training-connection-body">
                <span class="section-label">@Lang.T("Training Connection", "الربط بالتدريب")</span>
                <h3>@Lang.T("Government entities benefit from faster system adoption when training aligns with the operating system.", "تستفيد الجهات الحكومية من تبنٍّ أسرع للنظام حين يتوائم التدريب مع النظام التشغيلي.")</h3>
                <p>@Lang.T("MSSC programs are TVTC-registered, supporting government procurement requirements. Teams responsible for operating governance and performance systems are trained in the same frameworks the operating system is built on.", "برامج MSSC مُسجَّلة لدى المؤسسة العامة للتدريب التقني والمهني (TVTC)، بما يدعم متطلبات المشتريات الحكومية. وتُدرَّب الفرق المسؤولة عن تشغيل أنظمة الحوكمة والأداء على الأطر نفسها التي بُني عليها النظام التشغيلي.")</p>
                <a href="/training" class="btn btn-outline-primary btn-sm">@Lang.T("Explore Training Programs", "استكشف البرامج التدريبية")</a>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="cta-block" data-aos="fade-up" style="text-align: center; padding: 50px 30px; max-width: 900px; margin: 0 auto; background: var(--bg-light); border-radius: 16px;">
            <h2 class="section-title">@Lang.T("Start with clarity before full implementation.", "ابدأ بالوضوح قبل التنفيذ الكامل.")</h2>
            <p class="lead" style="margin: 18px auto 25px; max-width: 720px;">@Lang.T("If your institution requires stronger governance, clearer performance discipline, and more sustainable execution — start with the Institutional Readiness Diagnostic. Leadership receives a clear picture of current gaps, priority actions, and the most practical path forward.", "إذا كانت مؤسستك تحتاج حوكمة أقوى، وانضباط أداء أوضح، وتنفيذاً أكثر استدامة — فابدأ بتشخيص الجاهزية المؤسسية. تحصل القيادة على صورة واضحة للفجوات الحالية، والإجراءات ذات الأولوية، وأكثر المسارات عملية للمضيّ قدماً.")</p>
            <a href="/contact" class="btn btn-primary btn-lg">@Lang.T("Request Institutional Readiness Diagnostic", "اطلب تشخيص الجاهزية المؤسسية")</a>
            <a href="/contact" class="btn btn-outline-primary btn-lg ms-2">@Lang.T("Book a Discovery Call", "احجز جلسة استكشافية")</a>
        </div>
    </div>
</section>

@section Styles {
<style>
    .government-solutions-hero {
        background: linear-gradient(rgba(15, 30, 50, 0.78), rgba(10, 25, 45, 0.85)),
                    url('/images/industries/government.jpg') center/cover no-repeat;
        padding: 130px 0 56px;
        text-align: center;
        color: var(--white);
    }

    .government-solutions-hero h1 { color: var(--white); margin-bottom: 14px; }
    .government-solutions-hero h1 .text-secondary { color: var(--secondary); }
    .government-solutions-hero .lead { color: rgba(255,255,255,0.85); max-width: 760px; margin: 0 auto 18px; }

    .challenge-list {
        max-width: 880px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 22px;
    }

    .challenge-item {
        background: var(--white);
        padding: 14px 18px;
        border-radius: 8px;
        box-shadow: var(--shadow-sm);
        font-size: 0.9rem;
        color: var(--gray-700);
        line-height: 1.5;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .challenge-item i {
        color: #d97706;
        background: rgba(217, 119, 6, 0.1);
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .solutions-table {
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        gap: 12px;
    }

    .solution-row {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 22px;
        background: var(--white);
        padding: 20px 24px;
        border-radius: 10px;
        box-shadow: var(--shadow-sm);
        border-left: 3px solid var(--primary);
    }

    .solution-row-training {
        border-left-color: var(--secondary);
        background: linear-gradient(180deg, rgba(0, 200, 255, 0.04) 0%, var(--white) 100%);
    }

    .solution-row-title {
        font-weight: 700;
        color: var(--primary);
        font-size: 0.95rem;
    }

    .solution-row-body {
        font-size: 0.875rem;
        color: var(--gray-700);
        line-height: 1.55;
    }

    @@media (max-width: 768px) {
        .challenge-list { grid-template-columns: 1fr; }
        .solution-row { grid-template-columns: 1fr; gap: 6px; }
    }
</style>
}
