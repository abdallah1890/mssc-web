@{
    var clients = ViewBag.Clients as List<MSSC.Web.Models.Client>;
    var partners = ViewBag.Partners as List<MSSC.Web.Models.Partner>;
    var caseStudies = ViewBag.CaseStudies as List<MSSC.Web.Models.CaseStudy>;
}

<section class="page-hero proof-hub-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h1>أدلّة على <span class="text-secondary">الأثر المؤسسي.</span></h1>
            }
            else
            {
                <h1>Evidence of <span class="text-secondary">institutional impact.</span></h1>
            }
            <p class="lead">@Lang.T("Engagement snapshots, sector coverage, accreditations, and credibility metrics — the proof system behind every MSSC engagement.", "لمحات عن المشاريع، والقطاعات المغطّاة، والاعتمادات، ومؤشرات المصداقية — منظومة الأدلة خلف كل مشروع لـ MSSC.")</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("Proof Hub", "مركز الأدلة")</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <span class="section-label">@Lang.T("Credibility At A Glance", "المصداقية في لمحة")</span>
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">أرقام <span class="text-primary">تتحدّث.</span></h2>
            }
            else
            {
                <h2 class="section-title">Numbers that <span class="text-primary">speak.</span></h2>
            }
        </div>

        <div class="proof-stats-grid" data-aos="fade-up">
            <div class="proof-stat-card">
                <div class="proof-stat-num">50+</div>
                <div class="proof-stat-label">@Lang.T("Engagements Delivered", "مشروع مُنجَز")</div>
            </div>
            <div class="proof-stat-card">
                <div class="proof-stat-num">8+</div>
                <div class="proof-stat-label">@Lang.T("Sectors Served", "قطاع مخدوم")</div>
            </div>
            <div class="proof-stat-card">
                <div class="proof-stat-num">15+</div>
                <div class="proof-stat-label">@Lang.T("Years in Saudi Market", "عاماً في السوق السعودي")</div>
            </div>
            <div class="proof-stat-card">
                <div class="proof-stat-num">2,000+</div>
                <div class="proof-stat-label">@Lang.T("Professionals Trained", "متدرّب ومتدرّبة")</div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">تغطية <span class="text-primary">القطاعات.</span></h2>
            }
            else
            {
                <h2 class="section-title">Sector <span class="text-primary">coverage.</span></h2>
            }
            <p class="section-subtitle">@Lang.T("Government, healthcare, finance, education, utilities, and more — experience built across the institutional contexts that define Saudi Arabia.", "الحكومة، والرعاية الصحية، والتمويل، والتعليم، والمرافق، وغيرها — خبرة مبنية عبر السياقات المؤسسية التي تُميّز المملكة العربية السعودية.")</p>
        </div>

        <div class="sectors-grid">
            <div class="sector-tile" data-aos="fade-up"><i class="fas fa-landmark"></i><span>@Lang.T("Government", "الحكومة")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="60"><i class="fas fa-hospital"></i><span>@Lang.T("Healthcare", "الرعاية الصحية")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="120"><i class="fas fa-building-columns"></i><span>@Lang.T("Financial Services", "الخدمات المالية")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="180"><i class="fas fa-graduation-cap"></i><span>@Lang.T("Education", "التعليم")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="240"><i class="fas fa-bolt"></i><span>@Lang.T("Energy & Utilities", "الطاقة والمرافق")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="300"><i class="fas fa-industry"></i><span>@Lang.T("Manufacturing", "التصنيع")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="360"><i class="fas fa-tower-broadcast"></i><span>@Lang.T("Telecoms", "الاتصالات")</span></div>
            <div class="sector-tile" data-aos="fade-up" data-aos-delay="420"><i class="fas fa-bag-shopping"></i><span>@Lang.T("Retail", "التجزئة")</span></div>
        </div>
    </div>
</section>

@if (caseStudies != null && caseStudies.Any())
{
    <section class="section-padding">
        <div class="container">
            <div class="section-header text-center" data-aos="fade-up">
                @if (Lang.IsArabic)
                {
                    <h2 class="section-title">لمحات عن <span class="text-primary">المشاريع.</span></h2>
                }
                else
                {
                    <h2 class="section-title">Engagement <span class="text-primary">snapshots.</span></h2>
                }
                <p class="section-subtitle">@Lang.T("Anonymized engagement records: sector, challenge, system built, enable-stage approach, and outcomes — without client identification where confidentiality is required.", "سجلات مشاريع مجهّلة الهوية: القطاع، والتحدّي، والنظام المبني، ومنهجية مرحلة التمكين، والنتائج — دون تحديد هوية العميل حيثما تتطلّب السرية ذلك.")</p>
            </div>

            <div class="snapshots-grid">
                @foreach (var cs in caseStudies.Take(6))
                {
                    <div class="snapshot-card" data-aos="fade-up">
                        <div class="snapshot-sector">@cs.IndustryLocalized</div>
                        <h3>@cs.TitleLocalized</h3>
                        <p class="snapshot-challenge">@cs.ChallengeLocalized</p>
                        @if (cs.ResultsLocalized != null && cs.ResultsLocalized.Any())
                        {
                            <ul class="snapshot-results">
                                @foreach (var r in cs.ResultsLocalized.Take(3))
                                {
                                    <li><i class="fas fa-check"></i> @r</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section-padding bg-light">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">الاعتمادات <span class="text-primary">والشركاء.</span></h2>
            }
            else
            {
                <h2 class="section-title">Accreditations <span class="text-primary">&amp; partners.</span></h2>
            }
            <p class="section-subtitle">@Lang.T("Recognized credentials and institutional trust signals — visible across proposals, contracts, and credentials.", "اعتمادات معترف بها وإشارات ثقة مؤسسية — ظاهرة عبر العروض والعقود ووثائق الاعتماد.")</p>
        </div>

        <div class="accreditation-row" data-aos="fade-up">
            <div class="accred-badge">
                <img src="/images/accreditations/iosh.png" alt="IOSH" onerror="this.src='/images/accreditation-default.png'">
                <span>IOSH</span>
            </div>
            <div class="accred-badge">
                <img src="/images/accreditations/acmp.png" alt="ACMP" onerror="this.src='/images/accreditation-default.png'">
                <span>ACMP</span>
            </div>
            <div class="accred-badge">
                <img src="/images/accreditations/cpd.png" alt="CPD" onerror="this.src='/images/accreditation-default.png'">
                <span>CPD</span>
            </div>
            <div class="accred-badge">
                <img src="/images/accreditations/tvtc.svg" alt="TVTC" onerror="this.src='/images/accreditation-default.png'">
                <span>TVTC</span>
            </div>
        </div>

        @if (clients != null && clients.Any())
        {
            <h3 class="mid-heading mt-5" data-aos="fade-up">@Lang.T("Trusted by leading institutions", "موضع ثقة مؤسسات رائدة")</h3>
            <div class="proof-clients-grid" data-aos="fade-up">
                @foreach (var c in clients.Take(15))
                {
                    <div class="proof-client-logo" title="@c.Name">
                        <img src="@c.LogoUrl" alt="@c.Name" onerror="this.src='/images/client-default.png'">
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="cta-block" data-aos="fade-up" style="text-align: center; padding: 50px 30px; max-width: 900px; margin: 0 auto; background: var(--bg-light); border-radius: 16px;">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">اطّلع على كيف تبني MSSC <span class="text-primary">قدرات تدوم.</span></h2>
            }
            else
            {
                <h2 class="section-title">See how MSSC builds <span class="text-primary">capability that lasts.</span></h2>
            }
            <p class="lead" style="margin: 18px auto 25px; max-width: 720px;">
                @Lang.T("Begin with the Institutional Readiness Diagnostic. Leadership receives a structured view of current governance, performance, and capability maturity — with a clear, prioritized roadmap.", "ابدأ بتشخيص الجاهزية المؤسسية. تحصل القيادة على رؤية منظّمة لمستوى نضج الحوكمة والأداء والقدرات الحالي — مع خارطة طريق واضحة ومُرتَّبة حسب الأولوية.")
            </p>
            <a href="/contact" class="btn btn-primary btn-lg">@Lang.T("Request Institutional Readiness Diagnostic", "اطلب تشخيص الجاهزية المؤسسية")</a>
            <a href="/contact" class="btn btn-outline-primary btn-lg ms-2">@Lang.T("Book a Discovery Call", "احجز جلسة استكشافية")</a>
        </div>
    </div>
</section>

@section Styles {
<style>
    .proof-hub-hero {
        background: linear-gradient(rgba(15, 30, 50, 0.78), rgba(10, 25, 45, 0.85)),
                    url('/images/clients-partners-hero.jpg') center/cover no-repeat;
        padding: 130px 0 56px;
        text-align: center;
        color: var(--white);
    }

    .proof-hub-hero h1 { color: var(--white); margin-bottom: 14px; }
    .proof-hub-hero h1 .text-secondary { color: var(--secondary); }
    .proof-hub-hero .lead { color: rgba(255,255,255,0.85); max-width: 760px; margin: 0 auto 18px; }

    .proof-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .proof-stat-card {
        background: var(--white);
        padding: 32px 22px;
        border-radius: var(--radius-lg);
        text-align: center;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .proof-stat-num {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
        margin-bottom: 8px;
    }

    .proof-stat-label {
        font-size: 0.875rem;
        color: var(--gray-600);
        font-weight: 500;
    }

    .sectors-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .sector-tile {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--white);
        padding: 18px 20px;
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: var(--transition);
    }

    .sector-tile:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: var(--secondary);
    }

    .sector-tile i {
        color: var(--primary);
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .sector-tile span {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--gray-900);
    }

    .snapshots-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 22px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .snapshot-card {
        background: var(--white);
        padding: 24px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        border-left: 3px solid var(--primary);
    }

    .snapshot-sector {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--secondary);
        background: rgba(0, 200, 255, 0.1);
        padding: 4px 10px;
        border-radius: 20px;
        margin-bottom: 12px;
    }

    .snapshot-card h3 {
        font-size: 1.05rem;
        margin-bottom: 10px;
        line-height: 1.35;
    }

    .snapshot-challenge {
        font-size: 0.875rem;
        color: var(--gray-600);
        line-height: 1.55;
        margin-bottom: 14px;
    }

    .snapshot-results {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .snapshot-results li {
        font-size: 0.8125rem;
        color: var(--gray-700);
        padding: 4px 0 4px 22px;
        position: relative;
        line-height: 1.45;
    }

    .snapshot-results li i {
        position: absolute;
        left: 0;
        top: 6px;
        color: var(--primary);
        font-size: 0.7rem;
    }

    .accreditation-row {
        display: flex;
        gap: 24px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .accred-badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        background: var(--white);
        padding: 20px 26px;
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
        min-width: 120px;
    }

    .accred-badge img {
        height: 50px;
        width: auto;
        object-fit: contain;
    }

    .accred-badge span {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 1px;
    }

    .mid-heading {
        text-align: center;
        font-size: 1.05rem;
        margin-bottom: 22px;
        color: var(--gray-700);
    }

    .proof-clients-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .proof-client-logo {
        background: var(--white);
        border-radius: 8px;
        padding: 14px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-sm);
    }

    .proof-client-logo img {
        max-height: 50px;
        max-width: 100%;
        object-fit: contain;
    }

    @@media (max-width: 992px) {
        .proof-stats-grid { grid-template-columns: repeat(2, 1fr); }
        .sectors-grid { grid-template-columns: repeat(2, 1fr); }
        .proof-clients-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @@media (max-width: 600px) {
        .proof-stats-grid { grid-template-columns: 1fr; }
        .sectors-grid { grid-template-columns: 1fr; }
        .proof-clients-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
}
