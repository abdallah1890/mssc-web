@{
}

<section class="page-hero training-about-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h1>لا نقيس النجاح بعدد البرامج المقدَّمة، <span class="text-secondary">بل بالأثر التدريبي المستدام.</span></h1>
            }
            else
            {
                <h1>We don&#x2019;t measure success by programs delivered. <span class="text-secondary">We measure it by capability that stays.</span></h1>
            }
            <p class="lead">@Lang.T("Horizon Solutions Training Center is the structured training arm of the MSSC institutional advisory group. We offer professional training programs built on the same institutional frameworks used in our advisory work — so the people responsible for running governance and performance systems have the practical competence to do so.", "مركز آفاق الحلول للتدريب هو الذراع التدريبية المنظّمة لمجموعة MSSC للاستشارات المؤسسية. نقدّم برامج تدريبية احترافية مبنية على الأطر المؤسسية نفسها المستخدمة في عملنا الاستشاري — بحيث يمتلك المسؤولون عن تشغيل أنظمة الحوكمة والأداء الكفاءة العملية للقيام بذلك.")</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item"><a href="/training">@Lang.T("Training", "التدريب")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("About", "عن مركز التدريب")</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <span class="section-label">@Lang.T("Who We Are", "من نحن")</span>
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">الذراع التدريبية <span class="text-primary">لمجموعة MSSC للاستشارات المؤسسية.</span></h2>
            }
            else
            {
                <h2 class="section-title">The training arm of the <span class="text-primary">MSSC institutional advisory group.</span></h2>
            }
            <p class="section-subtitle">@Lang.T("MSSC is a Saudi-focused institutional advisory firm that helps government, semi-government, and enterprise organizations build governance structures, performance systems, and internal capability. Horizon Solutions Training Center is the structured training arm that delivers that same framework — directly to teams and individuals.", "MSSC شركة استشارات مؤسسية تركّز على السوق السعودي وتساعد الجهات الحكومية وشبه الحكومية والمؤسسات على بناء هياكل الحوكمة وأنظمة الأداء والقدرات الداخلية. ومركز آفاق الحلول للتدريب هو الذراع التدريبية المنظّمة التي تُقدّم الإطار نفسه — مباشرةً للفرق والأفراد.")</p>
        </div>

        <div class="about-narrative" data-aos="fade-up">
            <p>@Lang.T("We are not a generic training catalog. We are a structured capability system built around the institutional competencies that Saudi organizations actually need — governance, performance management, quality standards, safety, and digital operations.", "لسنا كتالوج تدريب عام. نحن نظام قدرات منظّم مبنيّ حول الكفاءات المؤسسية التي تحتاجها المؤسسات السعودية فعلاً — الحوكمة، وإدارة الأداء، ومعايير الجودة، والسلامة، والعمليات الرقمية.")</p>
            <p>@Lang.T("Every program is designed for application. Participants leave with competence they can use in their roles from day one, not just a certificate of attendance.", "كل برنامج مُصمَّم للتطبيق. يغادر المشاركون بكفاءة يستطيعون استخدامها في أدوارهم من اليوم الأول، لا بمجرد شهادة حضور.")</p>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">مبنيّ على الإطار نفسه. <span class="text-primary">يخدم الرسالة نفسها.</span></h2>
            }
            else
            {
                <h2 class="section-title">Built on the same framework. <span class="text-primary">Serving the same mission.</span></h2>
            }
            <p class="section-subtitle">@Lang.T("MSSC advisory engagements build institutional operating systems — governance frameworks, KPI structures, capability programs, and standards readiness. Training programs are designed to reinforce those same systems, so that the teams responsible for running them have the knowledge to do so.", "تبني مشاريع MSSC الاستشارية أنظمة تشغيل مؤسسية — أطر الحوكمة، وهياكل المؤشرات، وبرامج القدرات، والجاهزية للمعايير. والبرامج التدريبية مُصمَّمة لتعزيز هذه الأنظمة نفسها، بحيث تمتلك الفرق المسؤولة عن تشغيلها المعرفة اللازمة.")</p>
        </div>

        <div class="connection-tagline" data-aos="fade-up">
            <p>@Lang.T("MSSC Advisory builds the institutional system.", "استشارات MSSC تبني النظام المؤسسي.") <strong>@Lang.T("Horizon Solutions Training Center equips the people to run it.", "ومركز آفاق الحلول للتدريب يُجهّز الأشخاص لتشغيله.")</strong></p>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">خمسة أمور تُميّز <span class="text-primary">مركز آفاق الحلول للتدريب.</span></h2>
            }
            else
            {
                <h2 class="section-title">Five things that set <span class="text-primary">Horizon Solutions Training Center</span> apart.</h2>
            }
        </div>

        <div class="differentiators-grid">
            <div class="diff-card" data-aos="fade-up">
                <div class="diff-icon"><i class="fas fa-sitemap"></i></div>
                <h3>@Lang.T("Programs built on institutional frameworks", "برامج مبنية على أطر مؤسسية")</h3>
                <p>@Lang.T("Not generic professional development curricula. Every program is structured around governance, performance, standards, and operational competencies that Saudi government and enterprise organizations require.", "لا مناهج تطوير مهني عامة. كل برنامج مبنيّ حول كفاءات الحوكمة والأداء والمعايير والتشغيل التي تتطلّبها الجهات الحكومية والمؤسسات السعودية.")</p>
            </div>
            <div class="diff-card" data-aos="fade-up" data-aos-delay="100">
                <div class="diff-icon"><i class="fas fa-tools"></i></div>
                <h3>@Lang.T("Application over attendance", "التطبيق قبل الحضور")</h3>
                <p>@Lang.T("Programs are designed so participants can apply what they learned from day one. Practical outputs, real case examples, and competency-based assessment — not lecture and exam.", "البرامج مُصمَّمة بحيث يستطيع المشاركون تطبيق ما تعلّموه من اليوم الأول. مخرجات عملية، وأمثلة واقعية، وتقييم قائم على الجدارات — لا محاضرة واختبار.")</p>
            </div>
            <div class="diff-card" data-aos="fade-up" data-aos-delay="200">
                <div class="diff-icon"><i class="fas fa-mosque"></i></div>
                <h3>@Lang.T("Saudi context, international standards", "سياق سعودي، معايير دولية")</h3>
                <p>@Lang.T("Designed for the Saudi regulatory environment and institutional operating reality — while maintaining alignment with IOSH, ACMP, CPD, and ISO international standards.", "مُصمَّمة للبيئة التنظيمية السعودية والواقع التشغيلي المؤسسي — مع الحفاظ على المواءمة مع معايير IOSH وACMP وCPD وISO الدولية.")</p>
            </div>
            <div class="diff-card" data-aos="fade-up" data-aos-delay="300">
                <div class="diff-icon"><i class="fas fa-shield-halved"></i></div>
                <h3>@Lang.T("TVTC-registered for procurement", "مُسجَّل لدى TVTC للمشتريات")</h3>
                <p>@Lang.T("All programs are TVTC-registered — removing procurement barriers for government and semi-government clients who need recognized, approved training providers.", "جميع البرامج مُسجَّلة لدى TVTC — مما يزيل عوائق المشتريات للعملاء الحكوميين وشبه الحكوميين الذين يحتاجون مزوّدي تدريب معتمدين ومعترف بهم.")</p>
            </div>
            <div class="diff-card" data-aos="fade-up" data-aos-delay="400">
                <div class="diff-icon"><i class="fas fa-link"></i></div>
                <h3>@Lang.T("Connected to advisory engagements", "مرتبط بالمشاريع الاستشارية")</h3>
                <p>@Lang.T("The frameworks taught are the same frameworks used in MSSC advisory engagements. Organizations building systems with MSSC and training their teams here get consistent methodology across both tracks.", "الأطر التي تُدرَّس هي الأطر نفسها المستخدمة في مشاريع MSSC الاستشارية. والمؤسسات التي تبني أنظمتها مع MSSC وتدرّب فرقها هنا تحصل على منهجية متّسقة عبر المسارين.")</p>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            @if (Lang.IsArabic)
            {
                <h2 class="section-title">ممارسون، <span class="text-primary">لا مجرّد محاضرين.</span></h2>
            }
            else
            {
                <h2 class="section-title">Practitioners, <span class="text-primary">not instructors.</span></h2>
            }
            <p class="section-subtitle">@Lang.T("Our trainers are selected for two qualities: deep subject matter expertise in their field, and the ability to make complex institutional frameworks practical for the people in the room. They have working experience in Saudi government and enterprise environments. They understand how institutions actually operate — not just how frameworks are theoretically structured.", "يُختار مدرّبونا لصفتين: خبرة عميقة في مجالهم، والقدرة على جعل الأطر المؤسسية المعقّدة عملية لمن في القاعة. ولديهم خبرة عملية في بيئات الحكومة والمؤسسات السعودية. وهم يفهمون كيف تعمل المؤسسات فعلاً — لا كيف تُبنى الأطر نظرياً فحسب.")</p>
        </div>

        <div class="text-center" data-aos="fade-up">
            <a href="/training/trainers" class="btn btn-primary btn-lg">@Lang.T("Meet Our Trainers", "تعرّف على مدرّبينا")</a>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="cta-block" data-aos="fade-up" style="text-align: center; padding: 50px 30px; max-width: 900px; margin: 0 auto; background: var(--bg-light); border-radius: 16px;">
            <h2 class="section-title">@Lang.T("Reach the Horizon Solutions Training team.", "تواصل مع فريق مركز آفاق الحلول للتدريب.")</h2>
            <p class="lead" style="margin: 18px auto 25px; max-width: 720px;">@Lang.T("Whether you're a professional registering for an open enrollment cohort or an organization deploying corporate training across teams — we'll help you find the right path.", "سواء كنت مهنياً يسجّل في دفعة تسجيل مفتوح أو مؤسسة تنشر التدريب المؤسسي عبر فرقها — سنساعدك على إيجاد المسار المناسب.")</p>
            <a href="/training/programs" class="btn btn-primary btn-lg">@Lang.T("Register for a Program", "سجّل في برنامج")</a>
            <a href="/training/corporate" class="btn btn-outline-primary btn-lg ms-2">@Lang.T("Request Corporate Training", "اطلب تدريباً مؤسسياً")</a>
            <a href="/training/contact" class="btn btn-outline-primary btn-lg ms-2">@Lang.T("Book a Discovery Call", "احجز جلسة استكشافية")</a>
        </div>
    </div>
</section>

@section Styles {
<style>
    .training-about-hero {
        background: linear-gradient(rgba(15, 30, 50, 0.78), rgba(10, 25, 45, 0.85)),
                    url('/images/training-hero.jpg') center/cover no-repeat;
        padding: 130px 0 56px;
        text-align: center;
        color: var(--white);
    }

    .training-about-hero h1 { color: var(--white); margin-bottom: 14px; }
    .training-about-hero h1 .text-secondary { color: var(--secondary); }
    .training-about-hero .lead { color: rgba(255,255,255,0.85); max-width: 800px; margin: 0 auto 18px; }

    .about-narrative {
        max-width: 820px;
        margin: 0 auto;
        text-align: center;
    }

    .about-narrative p {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--gray-700);
        margin-bottom: 16px;
    }

    .connection-tagline {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        padding: 30px 28px;
        background: var(--white);
        border-radius: 14px;
        border-left: 4px solid var(--secondary);
        box-shadow: var(--shadow-md);
    }

    .connection-tagline p {
        font-size: 1.15rem;
        line-height: 1.5;
        color: var(--gray-700);
        margin: 0;
    }

    .connection-tagline strong {
        color: var(--primary);
    }
</style>
}
