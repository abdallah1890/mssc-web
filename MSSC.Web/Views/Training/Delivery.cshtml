@section Styles {
<style>
    .delivery-features {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1rem;
    }

    .feature-item i {
        font-size: 1.2rem;
    }

    .delivery-methods-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
    }

    .delivery-method-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

    .delivery-method-card:hover {
        transform: translateY(-5px);
    }

    .method-icon {
        width: 70px;
        height: 70px;
        background: var(--primary);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        margin-bottom: 20px;
    }

    .delivery-method-card h3 {
        margin-bottom: 15px;
        color: var(--text-dark);
    }

    .method-description {
        color: var(--text-muted);
        margin-bottom: 20px;
    }

    .method-features h4 {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--primary);
        margin-bottom: 15px;
    }

    .method-features ul {
        list-style: none;
        padding: 0;
        margin: 0 0 20px 0;
    }

    .method-features li {
        padding: 8px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        color: var(--text-dark);
    }

    .method-features li i {
        color: var(--primary);
        width: 20px;
    }

    .method-details {
        border-top: 1px solid var(--border-color);
        padding-top: 15px;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
        font-size: 0.9rem;
    }

    .detail-item .label {
        color: var(--text-muted);
    }

    .detail-item .value {
        font-weight: 600;
        color: var(--text-dark);
    }

    .experience-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }

    .experience-card {
        text-align: center;
        padding: 30px;
        background: var(--bg-light);
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

    .experience-card:hover {
        transform: translateY(-5px);
    }

    .experience-icon {
        width: 70px;
        height: 70px;
        background: var(--primary);
        border-radius: 50%;
