@{
    var ok = (bool)(ViewBag.PaymentOk ?? false);
    var result = ViewBag.PaymentResult as MSSC.Web.Models.HstcPaymentResult;
    var errorEn = ViewBag.PaymentError as string;
    var errorAr = ViewBag.PaymentErrorAr as string;
    var courseTitle = result != null ? Lang.Pick(result.CourseTitle ?? "", result.CourseTitleAr ?? "") : "";
    var errorMsg = ok ? "" : Lang.Pick(errorEn ?? "", errorAr ?? errorEn ?? "");
    var enrolled = result?.EnrollmentId != null;
}

<section class="page-hero register-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            <h1>@Lang.T("Payment Result", "نتيجة الدفع")</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item"><a href="/training">@Lang.T("Training Center", "مركز التدريب")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("Payment", "الدفع")</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="result-card @(ok ? "result-success" : "result-failure")" data-aos="fade-up">
                    @if (ok)
                    {
                        <div class="result-icon"><i class="fas fa-check-circle"></i></div>
                        <h2>@Lang.T("Payment Successful", "تم الدفع بنجاح")</h2>
                        @if (enrolled)
                        {
                            <p class="result-lead">@Lang.T("Your registration is confirmed and your seat is reserved. A confirmation email with your account details is on its way.", "تم تأكيد تسجيلك وحجز مقعدك. سيصلك بريد تأكيد يحتوي على بيانات حسابك قريباً.")</p>
                        }
                        else
                        {
                            <p class="result-lead">@Lang.T("Your payment was received. Our team is finalizing your seat and will email you shortly to confirm your enrollment.", "تم استلام دفعتك. يعمل فريقنا على تأكيد مقعدك وسيصلك بريد قريباً لتأكيد تسجيلك.")</p>
                        }

                        <div class="result-details">
                            @if (!string.IsNullOrEmpty(courseTitle))
                            {
                                <div class="detail-row"><span>@Lang.T("Program", "البرنامج")</span><strong>@courseTitle</strong></div>
                            }
                            @if (result != null)
                            {
                                <div class="detail-row"><span>@Lang.T("Amount Paid", "المبلغ المدفوع")</span><strong><span class="ltr-text">@result.Amount.ToString("#,0.##") @result.Currency</span></strong></div>
                                <div class="detail-row"><span>@Lang.T("Reference", "المرجع")</span><strong><span class="ltr-text">@result.PaymentId.ToString().Substring(0, 8).ToUpper()</span></strong></div>
                            }
                        </div>

                        <div class="result-actions">
                            <a href="https://portal.hstc.com.sa/en/login" target="_blank" rel="noopener" class="btn btn-primary">@Lang.T("Go to Training Portal", "الذهاب إلى بوابة التدريب")</a>
                            <a href="/training" class="btn btn-outline-secondary">@Lang.T("Back to Training Center", "العودة لمركز التدريب")</a>
                        </div>
                    }
                    else
                    {
                        <div class="result-icon"><i class="fas fa-times-circle"></i></div>
                        <h2>@Lang.T("Payment Not Completed", "لم يكتمل الدفع")</h2>
                        <p class="result-lead">@Lang.T("We couldn't confirm your payment. If any amount was deducted for an incomplete payment, it will be refunded automatically. Please try again.", "لم نتمكن من تأكيد دفعتك. إذا خُصم أي مبلغ عن دفعة غير مكتملة فسيُعاد تلقائياً. يُرجى المحاولة مرة أخرى.")</p>

                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="result-error-note">@errorMsg</div>
                        }

                        <div class="result-actions">
                            <a href="/training/register" class="btn btn-primary">@Lang.T("Try Again", "حاول مرة أخرى")</a>
                            <a href="/training/contact" class="btn btn-outline-secondary">@Lang.T("Contact Us", "تواصل معنا")</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
<style>
    .result-card {
        background: white;
        border-radius: 15px;
        padding: 50px 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        text-align: center;
    }
    .result-icon { font-size: 4.5rem; line-height: 1; margin-bottom: 20px; }
    .result-success .result-icon { color: #28a745; }
    .result-failure .result-icon { color: #dc3545; }
    .result-card h2 { margin-bottom: 12px; }
    .result-lead { color: #6b7a90; font-size: 1.05rem; line-height: 1.6; margin-bottom: 28px; }
    .result-details {
        text-align: start;
        border: 1px solid #dde3ea;
        border-radius: 10px;
        padding: 8px 20px;
        margin: 0 auto 28px;
        max-width: 460px;
    }
    .detail-row {
        display: flex; justify-content: space-between; gap: 16px;
        padding: 12px 0; border-bottom: 1px solid #eef1f5;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-row span { color: #6b7a90; }
    .result-error-note {
        background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;
        border-radius: 8px; padding: 12px 16px; margin-bottom: 24px;
    }
    .result-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .ltr-text { direction: ltr; unicode-bidi: embed; display: inline-block; }
    @@media (max-width: 576px) { .result-card { padding: 35px 22px; } }
</style>
}
