@section Scripts {
<script src="https://cdn.moyasar.com/mpf/1.18.0/moyasar.js"></script>
<script>
(function() {
    var programSelect = document.getElementById('program');
    var sessionSelect = document.getElementById('session');
    var sessionOptions = Array.from(sessionSelect.querySelectorAll('option[data-program-id]'));

    function filterSessions() {
        var selectedProgramId = programSelect.value;
        sessionSelect.value = '';

        sessionOptions.forEach(function(opt) {
            if (!selectedProgramId || opt.getAttribute('data-program-id') === selectedProgramId) {
                opt.style.display = '';
                opt.disabled = false;
            } else {
                opt.style.display = 'none';
                opt.disabled = true;
            }
        });
    }

    programSelect.addEventListener('change', filterSessions);

    function syncProgramFromSession() {
        var opt = sessionSelect.options[sessionSelect.selectedIndex];
        var pid = opt && opt.getAttribute('data-program-id');
        if (pid && programSelect.value !== pid) {
            var keep = sessionSelect.value;
            programSelect.value = pid;
            filterSessions();
            sessionSelect.value = keep;
        }
    }

    sessionSelect.addEventListener('change', syncProgramFromSession);

    if (sessionSelect.value) {
        syncProgramFromSession();
    } else if (programSelect.value) {
        filterSessions();
    }
})();

const HSTC_API_URL = '@(ViewBag.HstcApiUrl ?? "http://localhost:5050")';
const PORTAL_MODE = @(portalMode ? "true" : "false");
const CULTURE = (document.documentElement.lang || 'ar').startsWith('ar') ? 'ar' : 'en';

const T = {
    submitting: '@Lang.T("Processing...", "جارٍ المعالجة...")',
    payNow: '@Lang.T("Continue to Payment", "المتابعة للدفع")',
    submitReg: '@Lang.T("Submit Registration", "إرسال التسجيل")',
    companyRequired: '@Lang.T("Please enter your company name.", "يُرجى إدخال اسم الشركة.")',
    fee: '@Lang.T("Course fee:", "رسوم الدورة:")',
    amountDue: '@Lang.T("Amount due:", "المبلغ المستحق:")',
    regFailed: '@Lang.T("Registration failed:", "فشل التسجيل:")',
    payFailed: '@Lang.T("Could not start payment:", "تعذّر بدء الدفع:")',
    payLibFailed: '@Lang.T("The payment library failed to load. Please disable ad-blockers and try again.", "تعذّر تحميل مكتبة الدفع. يُرجى تعطيل مانع الإعلانات والمحاولة مجدداً.")',
    unknown: '@Lang.T("unknown error", "خطأ غير معروف")'
};

const form = document.getElementById('registrationForm');
const companyGroup = document.getElementById('companyNameGroup');
const companyInput = document.getElementById('companyName');
const feeHint = document.getElementById('feeHint');
const feeHintText = document.getElementById('feeHintText');
const payMethodGroup = document.getElementById('payMethodGroup');
const submitBtn = form.querySelector('button[type="submit"]');
const sessionSel = document.getElementById('session');
const programSel = document.getElementById('program');

function currentPayMode() {
    return form.querySelector('input[name="payMode"]:checked')?.value || 'individual';
}

function currentPayMethod() {
    return form.querySelector('input[name="payMethod"]:checked')?.value || 'card';
}

function labelForMode() {
    return currentPayMode() === 'company' ? T.submitReg : T.payNow;
}

function selectedSessionPrice() {
    const opt = sessionSel.options[sessionSel.selectedIndex];
    const p = opt ? parseFloat(opt.getAttribute('data-price')) : NaN;
    return (p && p > 0) ? p : 0;
}

function fmtSar(n) {
    const s = new Intl.NumberFormat(CULTURE === 'ar' ? 'ar-SA' : 'en-US',
        { minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(n);
    return s + ' ' + (CULTURE === 'ar' ? 'ر.س' : 'SAR');
}

function refreshPayUi() {
    const isCompany = currentPayMode() === 'company';
    companyGroup.style.display = isCompany ? '' : 'none';
    companyInput.required = isCompany;
    if (payMethodGroup) payMethodGroup.style.display = isCompany ? 'none' : '';

    const lbl = submitBtn.querySelector('.submit-label');
    if (lbl) lbl.textContent = labelForMode();

    const price = selectedSessionPrice();
    if (!isCompany && price > 0) {
        feeHint.style.display = '';
        feeHintText.textContent = T.fee + ' ' + fmtSar(price);
    } else {
        feeHint.style.display = 'none';
    }
}

form.querySelectorAll('input[name="payMode"]').forEach(r => r.addEventListener('change', refreshPayUi));
sessionSel.addEventListener('change', refreshPayUi);
programSel.addEventListener('change', refreshPayUi);
refreshPayUi();

function showError(msg) {
    const existing = form.querySelector('.alert-danger');
    if (existing) existing.remove();
    const box = document.createElement('div');
    box.className = 'alert alert-danger mt-3';
    box.textContent = msg;
    submitBtn.parentNode.insertBefore(box, submitBtn);
}

function setBusy(busy) {
    submitBtn.disabled = busy;
    submitBtn.innerHTML = busy
        ? '<i class="fas fa-spinner fa-spin"></i> ' + T.submitting
        : '<i class="fas fa-paper-plane me-2"></i><span class="submit-label">' + labelForMode() + '</span>';
}

async function createRegistration() {
    const selectedProgram = programSel.options[programSel.selectedIndex]?.text || '';
    const selectedSession = sessionSel.options[sessionSel.selectedIndex]?.text || '';
    const mode = currentPayMode();

    const fullName = form.fullName.value.trim();
    const spaceIdx = fullName.indexOf(' ');
    const firstName = spaceIdx > 0 ? fullName.slice(0, spaceIdx) : fullName;
    const lastName = spaceIdx > 0 ? fullName.slice(spaceIdx + 1).trim() : '';

    const payload = {
        firstName: firstName,
        lastName: lastName,
        email: form.email.value.trim(),
        phone: form.phone.value.trim(),
        companyName: mode === 'company' ? companyInput.value.trim() : null,
        notes: [
            'Program: ' + selectedProgram,
            selectedSession ? 'Session: ' + selectedSession : null,
            mode === 'company' ? 'Payment: Pay later via company' : 'Payment: Online (individual)'
        ].filter(Boolean).join('\n'),
        preferredLanguage: CULTURE,
        type: 1,
        source: 'MSSC.Web/Register',
        suppressConfirmationEmail: mode === 'individual'
    };

    if (PORTAL_MODE) {
        payload.courseId = programSel.value || null;
        payload.sessionId = sessionSel.value || null;
    }

    const res = await fetch(HSTC_API_URL + '/api/public/registrations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data?.isSuccessful) {
        throw new Error(data?.errorEntry?.errorMessage || ('Server returned ' + res.status));
    }
    return data.resultObject;
}

let cachedReg = null;
function registrationSignature() {
    return [
        programSel.value, sessionSel.value,
        form.fullName.value.trim(), form.email.value.trim(), form.phone.value.trim(),
        currentPayMode(),
        currentPayMode() === 'company' ? companyInput.value.trim() : ''
    ].join('|');
}
async function ensureRegistration() {
    const sig = registrationSignature();
    if (cachedReg && cachedReg.sig === sig && cachedReg.id) return { id: cachedReg.id };
    const reg = await createRegistration();
    cachedReg = { sig: sig, id: reg && reg.id };
    return reg;
}

function showRegistrationSuccess(refId) {
    form.innerHTML = `
        <div class="success-message text-center py-5">
            <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
            <h3 class="mt-4">@Lang.T("Registration Submitted!", "تم إرسال تسجيلك!")</h3>
            <p class="text-muted">@Lang.T("Thank you for your registration. Our team will contact you within 24 hours to confirm your enrollment.", "شكراً لتسجيلك. سيتواصل معك فريقنا خلال 24 ساعة لتأكيد تسجيلك.")</p>
            <p class="text-muted small">@Lang.T("Reference:", "المرجع:") ${refId || ''}</p>
            <a href="/training" class="btn btn-primary mt-3">@Lang.T("Back to Training Center", "العودة إلى مركز التدريب")</a>
        </div>
    `;
    form.style.display = '';
}

async function startPayment(registrationId) {
    const res = await fetch(HSTC_API_URL + '/api/public/payments/create-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ registrationId: registrationId })
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data?.isSuccessful) {
        const err = new Error(data?.errorEntry?.errorMessage || ('Server returned ' + res.status));
        err.code = data?.errorEntry?.errorCode;
        throw err;
    }
    const intent = data.resultObject;

    if (!intent.requiresPayment) {
        showRegistrationSuccess(registrationId);
        return;
    }

    if (typeof Moyasar === 'undefined' || !Moyasar || typeof Moyasar.init !== 'function') {
        throw new Error(T.payLibFailed);
    }

    const panel = document.getElementById('paymentPanel');
    document.getElementById('paymentAmountLine').textContent = T.amountDue + ' ' + fmtSar(intent.amount);
    panel.style.display = '';

    const initConfig = {
        element: '.mysr-form',
        amount: intent.amountMinor,
        currency: intent.currency,
        description: intent.description,
        publishable_api_key: intent.publishableKey,
        callback_url: window.location.origin + '/training/payment/callback',
        methods: (intent.methods && intent.methods.length) ? intent.methods : ['creditcard'],
        supported_networks: intent.supportedNetworks,
        language: CULTURE,
        metadata: {
            payment_id: intent.paymentId,
            registration_id: registrationId
        }
    };

    if (intent.applePay) {
        initConfig.apple_pay = {
            country: intent.applePay.country || 'SA',
            label: intent.applePay.label || 'HSTC',
            validate_merchant_url: intent.applePay.validateMerchantUrl
        };
    }

    try {
        Moyasar.init(initConfig);
    } catch (e) {
        panel.style.display = 'none';
        throw new Error(T.payLibFailed);
    }

    form.style.display = 'none';
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function startTamara(registrationId) {
    const res = await fetch(HSTC_API_URL + '/api/public/payments/tamara/create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ registrationId: registrationId })
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data?.isSuccessful) {
        const err = new Error(data?.errorEntry?.errorMessage || ('Server returned ' + res.status));
        err.code = data?.errorEntry?.errorCode;
        throw err;
    }
    const result = data.resultObject;

    if (!result.requiresPayment) {
        showRegistrationSuccess(registrationId);
        return;
    }
    if (!result.checkoutUrl) {
        throw new Error(T.payFailed + ' ' + T.unknown);
    }

    window.location.href = result.checkoutUrl;
}

async function startTabby(registrationId) {
    const res = await fetch(HSTC_API_URL + '/api/public/payments/tabby/create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ registrationId: registrationId })
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data?.isSuccessful) {
        const err = new Error(data?.errorEntry?.errorMessage || ('Server returned ' + res.status));
        err.code = data?.errorEntry?.errorCode;
        throw err;
    }
    const result = data.resultObject;

    if (!result.requiresPayment) {
        showRegistrationSuccess(registrationId);
        return;
    }
    if (!result.checkoutUrl) {
        throw new Error(T.payFailed + ' ' + T.unknown);
    }

    window.location.href = result.checkoutUrl;
}

form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const mode = currentPayMode();

    if (mode === 'company' && !companyInput.value.trim()) {
        showError(T.companyRequired);
        companyInput.focus();
        return;
    }

    const existing = form.querySelector('.alert-danger');
    if (existing) existing.remove();
    setBusy(true);

    let stage = 'reg';
    try {
        const reg = await ensureRegistration();
        if (mode === 'company') {
            showRegistrationSuccess(reg?.id);
            return;
        }
        stage = 'pay';
        const method = currentPayMethod();
        if (method === 'tamara') {
            await startTamara(reg.id);
        } else if (method === 'tabby') {
            await startTabby(reg.id);
        } else {
            await startPayment(reg.id);
        }
    } catch (err) {
        setBusy(false);
        if (err && err.code === 'AlreadyEnrolled') {
            showError(err.message);
        } else {
            showError((stage === 'pay' ? T.payFailed : T.regFailed) + ' ' + (err.message || T.unknown));
        }
    }
});
</script>
}
