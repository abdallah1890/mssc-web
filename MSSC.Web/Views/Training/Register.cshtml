@{
    var sessionList = ViewBag.SessionList as List<MSSC.Web.Models.TrainingSession> ?? new List<MSSC.Web.Models.TrainingSession>();
    var courseOptions = ViewBag.CourseOptions as List<MSSC.Web.Models.CourseOption> ?? new List<MSSC.Web.Models.CourseOption>();
    var selectedSessionValue = ViewBag.SelectedSessionValue as string;
    var selectedCourseValue = ViewBag.SelectedCourseValue as string;
    var portalMode = (bool)(ViewBag.PortalMode ?? false);
}

<section class="page-hero register-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            <h1>@Lang.T("Register for Training", "التسجيل في التدريب")</h1>
            <p class="lead">@Lang.T("Secure your seat in our professional development programs", "احجز مقعدك في برامجنا للتطوير المهني")</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item"><a href="/training">@Lang.T("Training Center", "مركز التدريب")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("Register", "التسجيل")</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-8" data-aos="fade-right">
                <div class="registration-form-card">
                    <h2>@Lang.T("Registration Form", "نموذج التسجيل")</h2>
                    <p class="form-subtitle">@Lang.T("Please fill out the form below to register for training. Our team will contact you within 24 hours to confirm your registration.", "يُرجى تعبئة النموذج أدناه للتسجيل في التدريب. وسيتواصل معك فريقنا خلال 24 ساعة لتأكيد تسجيلك.")</p>

                    <form id="registrationForm" class="registration-form">
                        <div class="form-section">
                            <h3><i class="fas fa-graduation-cap"></i> @Lang.T("Training Selection", "اختيار التدريب")</h3>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="program">@Lang.T("Select Program *", "اختر البرنامج *")</label>
                                        <select id="program" name="program" class="form-control" required>
                                            <option value="">@Lang.T("Choose a program...", "اختر برنامجاً...")</option>
                                            @foreach (var course in courseOptions)
                                            {
                                                if (selectedCourseValue == course.Id)
                                                {
                                                    <option value="@course.Id" selected>@course.TitleLocalized</option>
                                                }
                                                else
                                                {
                                                    <option value="@course.Id">@course.TitleLocalized</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="session">@Lang.T("Select Session", "اختر الجلسة")</label>
                                        <select id="session" name="session" class="form-control">
                                            <option value="">@Lang.T("Choose a session (optional)...", "اختر جلسة (اختياري)...")</option>
                                            @foreach (var session in sessionList)
                                            {
                                                if (selectedSessionValue == session.PortalSessionId)
                                                {
                                                    <option value="@session.PortalSessionId" data-program-id="@session.PortalCourseId" data-price="@session.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected>@session.ProgramTitleLocalized - @session.StartDate.ToString("MMM dd, yyyy") (@session.LocationLocalized)</option>
                                                }
                                                else
                                                {
                                                    <option value="@session.PortalSessionId" data-program-id="@session.PortalCourseId" data-price="@session.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">@session.ProgramTitleLocalized - @session.StartDate.ToString("MMM dd, yyyy") (@session.LocationLocalized)</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3><i class="fas fa-user"></i> @Lang.T("Your Details", "بياناتك")</h3>

                            <div class="form-group">
                                <label for="fullName">@Lang.T("Full Name *", "الاسم الكامل *")</label>
                                <input type="text" id="fullName" name="fullName" class="form-control" required>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="email">@Lang.T("Email Address *", "البريد الإلكتروني *")</label>
                                        <input type="email" id="email" name="email" class="form-control" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="phone">@Lang.T("Phone Number *", "رقم الجوال *")</label>
                                        <input type="tel" id="phone" name="phone" class="form-control" required>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="consent-check" for="terms">
                                    <input type="checkbox" id="terms" name="terms" required>
                                    <span class="consent-text">
                                        @Lang.T("I agree to the", "أوافق على") <a href="/terms" target="_blank">@Lang.T("Terms & Conditions", "الشروط والأحكام")</a> @Lang.T("and", "و") <a href="/privacy" target="_blank">@Lang.T("Privacy Policy", "سياسة الخصوصية")</a> <span class="required-mark">*</span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3><i class="fas fa-money-check-alt"></i> @Lang.T("Payment", "الدفع")</h3>

                            <div class="pay-mode-options">
                                <label class="pay-mode-card">
                                    <input type="radio" name="payMode" value="individual" checked>
                                    <span class="pay-mode-body">
                                        <span class="pay-mode-title">@Lang.T("Pay now (individual)", "الدفع الآن (كفرد)")</span>
                                        <span class="pay-mode-desc">@Lang.T("Pay online securely and reserve your seat instantly.", "ادفع أونلاين بأمان واحجز مقعدك فوراً.")</span>
                                    </span>
                                </label>
                                <label class="pay-mode-card">
                                    <input type="radio" name="payMode" value="company">
                                    <span class="pay-mode-body">
                                        <span class="pay-mode-title">@Lang.T("I belong to a company (pay later)", "تابع لشركة (الدفع لاحقاً)")</span>
                                        <span class="pay-mode-desc">@Lang.T("Your company will be invoiced. Our team will contact you.", "ستُفوتَر شركتك. سيتواصل معك فريقنا.")</span>
                                    </span>
                                </label>
                            </div>

                            <div class="pay-method-group mt-3" id="payMethodGroup">
                                <label class="pay-method-label">@Lang.T("Payment method", "طريقة الدفع")</label>
                                <div class="pay-method-options">
                                    <label class="pay-method-card">
                                        <input type="radio" name="payMethod" value="card" checked>
                                        <span class="pay-method-body">
                                            <span class="pay-method-title">@Lang.T("Card / mada", "بطاقة / مدى")</span>
                                            <span class="pay-method-logos">
                                                <img src="~/images/payment/mada.svg" asp-append-version="true" alt="mada" height="20">
                                                <img src="~/images/payment/visa.svg" asp-append-version="true" alt="Visa" height="20">
                                                <img src="~/images/payment/mastercard.svg" asp-append-version="true" alt="Mastercard" height="20">
                                                <img src="~/images/payment/applepay.svg" asp-append-version="true" alt="Apple Pay" height="20">
                                            </span>
                                        </span>
                                    </label>
                                    <label class="pay-method-card">
                                        <input type="radio" name="payMethod" value="tamara">
                                        <span class="pay-method-body">
                                            <span class="pay-method-title">@Lang.T("Split with Tamara", "قسّمها مع تمارا")</span>
                                            <span class="pay-method-logos">
                                                <img src="~/images/payment/tamara.svg" asp-append-version="true" alt="Tamara" height="22">
                                            </span>
                                            <span class="pay-method-desc">@Lang.T("Pay in instalments, Sharia-compliant, no interest.", "قسّط على دفعات، متوافق مع الشريعة، بدون فوائد.")</span>
                                        </span>
                                    </label>
                                    <label class="pay-method-card">
                                        <input type="radio" name="payMethod" value="tabby">
                                        <span class="pay-method-body">
                                            <span class="pay-method-title">@Lang.T("Split with Tabby", "قسّمها مع تابي")</span>
                                            <span class="pay-method-logos">
                                                <img src="~/images/payment/tabby.svg" asp-append-version="true" alt="Tabby" height="22">
                                            </span>
                                            <span class="pay-method-desc">@Lang.T("Pay in 4, Sharia-compliant, no interest.", "قسّمها على 4 دفعات، متوافق مع الشريعة، بدون فوائد.")</span>
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-group mt-3" id="companyNameGroup" style="display:none;">
                                <label for="companyName">@Lang.T("Company Name *", "اسم الشركة *")</label>
                                <input type="text" id="companyName" name="companyName" class="form-control">
                            </div>

                            <div class="fee-hint" id="feeHint" style="display:none;">
                                <i class="fas fa-tag"></i> <span id="feeHintText"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg btn-submit">
                            <i class="fas fa-paper-plane me-2"></i><span class="submit-label">@Lang.T("Submit Registration", "إرسال التسجيل")</span>
                        </button>
                    </form>

                    <div id="paymentPanel" class="payment-panel" style="display:none;">
                        <h3 class="payment-panel-title"><i class="fas fa-lock"></i> @Lang.T("Secure Payment", "دفع آمن")</h3>
                        <p class="payment-amount-line" id="paymentAmountLine"></p>
                        <div class="mysr-form"></div>
                        <p class="payment-secure-note">@Lang.T("Payments are processed securely by Moyasar. Your card details never touch our servers.", "تتم معالجة المدفوعات بأمان عبر ميسّر. لا تمر بيانات بطاقتك عبر خوادمنا.")</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4" data-aos="fade-left">
                <div class="registration-sidebar">
                    <div class="sidebar-card">
                        <h3>@Lang.T("Need Help?", "تحتاج مساعدة؟")</h3>
                        <p>@Lang.T("Our team is here to assist you with the registration process.", "فريقنا هنا لمساعدتك في عملية التسجيل.")</p>
                        <div class="contact-info">
                            <div class="contact-item">
                                <i class="fas fa-phone"></i>
                                <span class="ltr-text">+966 54 361 8430</span>
                            </div>
                            <div class="contact-item">
                                <i class="fas fa-envelope"></i>
                                <span class="ltr-text">training@mssc.com.sa</span>
                            </div>
                            <div class="contact-item">
                                <i class="fas fa-clock"></i>
                                <span>@Lang.T("Sun-Thu: 8am - 5pm", "الأحد-الخميس: 8 صباحاً - 5 مساءً")</span>
                            </div>
                        </div>
                    </div>

                    <div class="sidebar-card mt-4">
                        <h3>@Lang.T("What's Included", "ما يشمله")</h3>
                        <ul class="included-list">
                            <li><i class="fas fa-check-circle"></i> @Lang.T("Course materials & handouts", "مواد الدورة والنشرات")</li>
                            <li><i class="fas fa-check-circle"></i> @Lang.T("Certificate of completion", "شهادة إتمام")</li>
                            <li><i class="fas fa-check-circle"></i> @Lang.T("Refreshments & lunch", "مرطبات وغداء")</li>
                            <li><i class="fas fa-check-circle"></i> @Lang.T("Post-training support", "دعم بعد التدريب")</li>
                            <li><i class="fas fa-check-circle"></i> @Lang.T("Digital resources access", "وصول للموارد الرقمية")</li>
                        </ul>
                    </div>

                    <div class="sidebar-card mt-4">
                        <h3>@Lang.T("Cancellation Policy", "سياسة الإلغاء")</h3>
                        <ul class="policy-list">
                            <li><strong>@Lang.T("14+ days:", "14 يوماً فأكثر:")</strong> @Lang.T("Full refund", "استرداد كامل")</li>
                            <li><strong>@Lang.T("7-13 days:", "7-13 يوماً:")</strong> @Lang.T("50% refund", "استرداد 50%")</li>
                            <li><strong>@Lang.T("Less than 7 days:", "أقل من 7 أيام:")</strong> @Lang.T("No refund (transfer available)", "بلا استرداد (التحويل متاح)")</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

