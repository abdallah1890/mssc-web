@model List<MSSC.Web.Models.TrainingSession>
@{
    var categories = ViewBag.Categories as List<MSSC.Web.Models.TrainingCategory>;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalItems = (int)(ViewBag.TotalItems ?? Model.Count);
    var firstItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastItem = System.Math.Min(currentPage * pageSize, totalItems);
}

<section class="page-hero schedule-hero">
    <div class="container">
        <div class="hero-content" data-aos="fade-up">
            <h1>@Lang.T("2026 Training Calendar", "تقويم التدريب 2026")</h1>
            <p class="lead">@Lang.T("All programs are delivered online. Registration closes 5 business days before the program start date. Group registrations and dedicated cohort scheduling available for organizations.", "تُقدَّم جميع البرامج عبر الإنترنت. ويُغلق التسجيل قبل 5 أيام عمل من تاريخ بدء البرنامج. وتتوفّر تسجيلات المجموعات وجدولة دفعات مخصّصة للمؤسسات.")</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">@Lang.T("Home", "الرئيسية")</a></li>
                    <li class="breadcrumb-item"><a href="/training">@Lang.T("Training", "التدريب")</a></li>
                    <li class="breadcrumb-item active">@Lang.T("Calendar", "التقويم")</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="schedule-wrapper" data-aos="fade-up">
            <div class="schedule-header">
                <h2>@Lang.T("2026 Training Schedule", "جدول التدريب 2026")</h2>
                <p>@Lang.T("Showing", "عرض") <strong>@firstItem&#x2013;@lastItem</strong> @Lang.T("of", "من") <strong>@totalItems</strong> @Lang.T("sessions · Prices in SAR, exclusive of VAT · Group pricing available for 3+ participants", "جلسة · الأسعار بالريال السعودي، غير شاملة ضريبة القيمة المضافة · تتوفّر أسعار للمجموعات لـ 3 مشاركين فأكثر")</p>
            </div>

            <div class="table-responsive">
                <table class="table schedule-table">
                    <thead>
                        <tr>
                            <th class="col-no">#</th>
                            <th class="col-program">@Lang.T("Program", "البرنامج")</th>
                            <th class="col-accreditation">@Lang.T("Accreditation", "الاعتماد")</th>
                            <th class="col-date">@Lang.T("Date", "التاريخ")</th>
                            <th class="col-duration">@Lang.T("Duration", "المدة")</th>
                            <th class="col-delivery">@Lang.T("Delivery", "التقديم")</th>
                            <th class="col-price">@Lang.T("Price (SAR)", "السعر (ريال)")</th>
                            <th class="col-action">@Lang.T("Action", "الإجراء")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model)
                        {
                            <tr>
                                <td class="col-no">@session.Id</td>
                                <td class="col-program">
                                    <div class="program-info">
                                        <strong>@session.ProgramTitleLocalized</strong>
                                    </div>
                                </td>
                                <td class="col-accreditation">
                                    @if (session.AccreditationBody != "—")
                                    {
                                        <span class="accreditation-badge">@session.AccreditationBody</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="col-date">
                                    <div class="date-info">
                                        <span class="date">@session.StartDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </td>
                                <td class="col-duration">@session.DurationDays @Lang.T("Days", "يوم")</td>
                                <td class="col-delivery">
                                    <span class="location-badge virtual">
                                        <i class="fas fa-video"></i>
                                        @session.LocationLocalized
                                    </span>
                                </td>
                                <td class="col-price">@session.Price.ToString("N0")</td>
                                <td class="col-action">
                                    <a href="/training/register?sessionId=@(session.PortalSessionId ?? session.Id.ToString())" class="btn btn-primary btn-sm">@Lang.T("Register", "سجّل")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="pagination-wrapper" aria-label="Schedule pagination">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@(currentPage == 1 ? "#" : "?page=" + (currentPage - 1))" aria-label="Previous">
                                <i class="fas fa-chevron-left dir-arrow"></i>
                                <span class="page-link-text">@Lang.T("Previous", "السابق")</span>
                            </a>
                        </li>

                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@p">@p</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(currentPage == totalPages ? "#" : "?page=" + (currentPage + 1))" aria-label="Next">
                                <span class="page-link-text">@Lang.T("Next", "التالي")</span>
                                <i class="fas fa-chevron-right dir-arrow"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</section>


@{
    var scheduleSchema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "BreadcrumbList",
                ["itemListElement"] = new object[]
                {
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = Lang.T("Home", "الرئيسية"), ["item"] = SeoModel.SiteUrl + "/" },
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = Lang.T("Training", "التدريب"), ["item"] = SeoModel.SiteUrl + "/training" },
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Lang.T("Calendar", "التقويم"), ["item"] = SeoModel.SiteUrl + "/training/schedule" }
                }
            },
            new Dictionary<string, object>
            {
                ["@type"] = "ItemList",
                ["itemListElement"] = Model.Select((s, i) =>
                {
                    var course = new Dictionary<string, object>
                    {
                        ["@type"] = "Course",
                        ["name"] = s.ProgramTitleLocalized,
                        ["provider"] = new Dictionary<string, object>
                        {
                            ["@type"] = "EducationalOrganization",
                            ["@id"] = SeoModel.SiteUrl + "/training#organization",
                            ["name"] = "Horizon Solutions Training Center"
                        },
                        ["hasCourseInstance"] = new Dictionary<string, object>
                        {
                            ["@type"] = "CourseInstance",
                            ["courseMode"] = "Online",
                            ["startDate"] = s.StartDate.ToString("yyyy-MM-dd"),
                            ["endDate"] = s.EndDate.ToString("yyyy-MM-dd")
                        }
                    };
                    if (s.Price > 0)
                        course["offers"] = new Dictionary<string, object>
                        {
                            ["@type"] = "Offer",
                            ["price"] = s.Price,
                            ["priceCurrency"] = "SAR",
                            ["url"] = SeoModel.SiteUrl + "/training/register?sessionId=" + (s.PortalSessionId ?? s.Id.ToString())
                        };
                    return new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = i + 1, ["item"] = course };
                }).ToList()
            }
        }
    };
}
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(scheduleSchema))</script>

@section Styles {
<style>
    .schedule-wrapper {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .schedule-header {
        padding: 25px 30px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .schedule-header h2 {
        margin: 0;
    }

    .schedule-header p {
        margin: 0;
        color: var(--text-muted);
    }

    .schedule-table {
        margin: 0;
        width: 100%;
    }

    .schedule-table th {
        background: var(--bg-light);
        border: none;
        padding: 15px 12px;
        font-weight: 600;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .schedule-table td {
        padding: 16px 12px;
        vertical-align: middle;
        border-bottom: 1px solid var(--border-color);
    }

    .col-no { width: 4%; text-align: center; }
    .col-program { width: 26%; }
    .col-accreditation { width: 16%; }
    .col-date { width: 14%; }
    .col-duration { width: 10%; text-align: center; }
    .col-delivery { width: 10%; }
    .col-price { width: 10%; text-align: right; font-weight: 600; }
    .col-action { width: 10%; text-align: center; }

    .program-info strong {
        color: var(--text-dark);
    }

    .date-info .date {
        display: block;
        font-weight: 600;
    }

    .accreditation-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        background: #f3e8ff;
        color: #7c3aed;
    }

    .location-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
    }

    .location-badge.virtual {
        background: #e3f2fd;
        color: #1565c0;
    }

    .location-badge.onsite {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .pagination-wrapper {
        display: flex;
        justify-content: center;
        padding: 24px 30px 30px;
        background: var(--white);
    }

    .pagination {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .pagination .page-item .page-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-width: 40px;
        height: 40px;
        padding: 0 14px;
        border-radius: 8px;
        background: var(--white);
        border: 1px solid var(--gray-200);
        color: var(--gray-700);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .pagination .page-item .page-link:hover {
        background: var(--bg-light);
        color: var(--primary);
        border-color: var(--primary);
    }

    .pagination .page-item.active .page-link {
        background: var(--primary);
        color: var(--white);
        border-color: var(--primary);
        cursor: default;
    }

    .pagination .page-item.disabled .page-link {
        opacity: 0.45;
        pointer-events: none;
        background: var(--bg-light);
    }

    .pagination .page-item .page-link i {
        font-size: 0.75rem;
    }

    @@media (max-width: 768px) {
        .schedule-header {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }

        .schedule-table th,
        .schedule-table td {
            padding: 10px 8px;
            font-size: 0.85rem;
        }

        .col-no, .col-duration, .col-delivery {
            display: none;
        }

        .pagination-wrapper {
            padding: 18px 12px 22px;
        }

        .pagination .page-item .page-link {
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            font-size: 0.8125rem;
        }

        .pagination .page-item .page-link .page-link-text {
            display: none;
        }
    }
</style>
}
